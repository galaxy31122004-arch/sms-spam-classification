                         {
                             "file":  "02-chuong-1-co-so-ly-thuyet.md",
                             "tag":  "1.1",
                             "formula":  "idf(t)=\\log\\frac{1+N}{1+df(t)}+1,\\qquad\nu_{t,d}=tf(t,d)\\,idf(t). \\tag{1.1}"
                         },
                         {
                             "file":  "02-chuong-1-co-so-ly-thuyet.md",
                             "tag":  "1.2",
                             "formula":  "p=\\sigma(z)=\\frac{1}{1+e^{-z}},\\qquad\n\\widehat y=\\begin{cases}1,\u0026p\\geq\\tau,\\\\0,\u0026p\u003c\\tau,\\end{cases}\\quad\\tau=0{,}5. \\tag{1.2}"
                         },
                         {
                             "file":  "02-chuong-1-co-so-ly-thuyet.md",
                             "tag":  "1.3",
                             "formula":  "\\begin{aligned}\ni_t\u0026=\\sigma(W_i x_t+U_i h_{t-1}+b_i),\\\\\nf_t\u0026=\\sigma(W_f x_t+U_f h_{t-1}+b_f),\\\\\ng_t\u0026=\\tanh(W_g x_t+U_g h_{t-1}+b_g),\\\\\no_t\u0026=\\sigma(W_o x_t+U_o h_{t-1}+b_o),\\\\\nc_t\u0026=f_t\\odot c_{t-1}+i_t\\odot g_t,\\\\\nh_t\u0026=o_t\\odot\\tanh(c_t).\n\\end{aligned} \\tag{1.3}"
                         },
                         {
                             "file":  "02-chuong-1-co-so-ly-thuyet.md",
                             "tag":  "1.4",
                             "formula":  "X_t=E_{k_t}+P_t,\\quad t=0,\\ldots,L-1. \\tag{1.4}"
                         },
                         {
                             "file":  "02-chuong-1-co-so-ly-thuyet.md",
                             "tag":  "1.5",
                             "formula":  "\\operatorname{Attention}(Q,K,V)=\\operatorname{softmax}\\!\\left(\\frac{QK^\\top}{\\sqrt{d_k}}+M\\right)V. \\tag{1.5}"
                         },
                         {
                             "file":  "02-chuong-1-co-so-ly-thuyet.md",
                             "tag":  "1.6",
                             "formula":  "\\operatorname{FFN}(H)=\\operatorname{ReLU}(HW_1+b_1)W_2+b_2. \\tag{1.6}"
                         },
                         {
                             "file":  "02-chuong-1-co-so-ly-thuyet.md",
                             "tag":  "1.7",
                             "formula":  "H=\\operatorname{LN}(X+\\operatorname{Dropout}(\\operatorname{MHA}(X))),\\quad\nZ=\\operatorname{LN}(H+\\operatorname{Dropout}(\\operatorname{FFN}(H))). \\tag{1.7}"
                         },
                         {
                             "file":  "02-chuong-1-co-so-ly-thuyet.md",
                             "tag":  "1.8",
                             "formula":  "v=\\frac{\\sum_{t=0}^{L-1}m_t Z_t}{\\max\\!\\left(1,\\sum_{t=0}^{L-1}m_t\\right)},\\qquad\nm_t=\\begin{cases}1,\u0026k_t\\ne0,\\\\0,\u0026k_t=0.\\end{cases} \\tag{1.8}"
                         },
                         {
                             "file":  "02-chuong-1-co-so-ly-thuyet.md",
                             "tag":  "1.9",
                             "formula":  "\\mathcal L=-\\frac{1}{B}\\sum_{i=1}^{B}\\left[w_+y_i\\log p_i+(1-y_i)\\log(1-p_i)\\right],\\qquad\nw_+=\\frac{N_{HAM}^{train}}{N_{SPAM}^{train}}. \\tag{1.9}"
                         },
                         {
                             "file":  "02-chuong-1-co-so-ly-thuyet.md",
                             "tag":  "1.10",
                             "formula":  "Accuracy=\\frac{TP+TN}{N},\\quad Precision=\\frac{TP}{TP+FP},\\quad\nRecall=\\frac{TP}{TP+FN},\\quad F1=\\frac{2TP}{2TP+FP+FN}. \\tag{1.10}"
                         },
                         {
